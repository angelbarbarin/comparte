# Copia este archivo como ".env" y ajusta lo que necesites. Nada de esto es obligatorio:
# sin configurar nada, ComParte arranca con SQLite local y el motor de lenguaje por reglas.

# --- Motor de lenguaje del Agente Captador ---------------------------------------------------
# auto   = usa Claude si hay ANTHROPIC_API_KEY, si no usa el motor de reglas (por defecto)
# reglas = siempre el motor de reglas (gratis, determinista, sin internet)
# claude = obliga a usar Claude (falla al arrancar si no hay clave)
COMPARTE_LLM=auto
# Clave de la API de Anthropic. NUNCA la subas al repositorio.
ANTHROPIC_API_KEY=
# Modelo de Claude para extraer los datos de la donación. Para abaratar costos puedes probar
# "claude-haiku-5-5" (compara su precisión con scripts/evaluar_captador.py).
COMPARTE_MODELO=claude-opus-5-5

# --- Datos -----------------------------------------------------------------------------------
# Por defecto: sqlite:///data/comparte.db. Para PostgreSQL: postgresql+psycopg://usuario:clave@host/db
# COMPARTE_DB_URL=
# Carpeta para la base SQLite y las fotos subidas (por defecto ./data)
# COMPARTE_DATOS=

# --- Demo ------------------------------------------------------------------------------------
# Fija la hora "de la aplicación" (HH:MM). Útil para grabar el video a cualquier hora del día:
# a las 23:00 todos los receptores estarían cerrados.
# COMPARTE_HORA_DEMO=17:30

# --- Reglas operativas -----------------------------------------------------------------------
# Minutos que tiene un receptor / un voluntario para responder antes de reasignar
# COMPARTE_VIGENCIA_OFERTA_MIN=15
# COMPARTE_VIGENCIA_RECOLECCION_MIN=10
# Velocidad media urbana (km/h) y factor de circuito (distancia por calles / línea recta)
# COMPARTE_VELOCIDAD_KMH=25
# COMPARTE_FACTOR_CIRCUITO=1.3
